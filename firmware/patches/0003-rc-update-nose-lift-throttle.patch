 #include <uORB/SubscriptionCallback.hpp>
 #include <uORB/topics/manual_control_setpoint.h>
 #include <uORB/topics/manual_control_switches.h>
+#include <uORB/topics/nose_lift_output.h>
 #include <uORB/topics/input_rc.h>
 #include <uORB/topics/rc_channels.h>
 #include <uORB/topics/rc_parameter_map.h>
@@ -168,6 +169,10 @@ protected:
 
 	uORB::SubscriptionCallbackWorkItem _input_rc_sub{this, ORB_ID(input_rc)};
 
+	// AIRFRAME_DESIGNER nose lift: a throttle the automatic takeoff/hover/landing asks for in place of the stick
+	uORB::Subscription _nose_lift_output_sub{ORB_ID(nose_lift_output)};
+	nose_lift_output_s _nose_lift_output{};
+
 	uORB::SubscriptionInterval _parameter_update_sub{ORB_ID(parameter_update), 1_s};
 
 	uORB::Subscription _rc_parameter_map_sub{ORB_ID(rc_parameter_map)};
