{
  "name": "cruise",
  "description": "Take off, hover, then fly forward at 12 m/s for 15 s in offboard velocity control, then stop. Cruise pitch, power ratio vs hover and wing lift share come from the 'cruise' phase.",
  "max_time": 140,
  "params": {"MIS_TAKEOFF_ALT": 8, "MPC_XY_VEL_MAX": 20, "MPC_XY_CRUISE": 12, "MPC_TILTMAX_AIR": 45},
  "abort": {"max_tilt_deg": 100, "max_alt": 80, "crash_speed": 3.0},
  "phases": [
    {"type": "wait_ready", "timeout": 45},
    {"type": "takeoff", "alt": 8, "settle": 2, "timeout": 30},
    {"type": "hold", "name": "hover", "duration": 6},
    {"type": "offboard_velocity", "name": "accelerate", "vel": [12, 0, 0], "duration": 6, "yaw": 0},
    {"type": "offboard_velocity", "name": "cruise", "vel": [12, 0, 0], "duration": 12, "yaw": 0},
    {"type": "offboard_velocity", "name": "brake", "vel": [0, 0, 0], "duration": 8, "yaw": 0},
    {"type": "hold", "name": "hover_after", "duration": 4}
  ]
}
