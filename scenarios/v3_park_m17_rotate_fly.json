{
  "name": "v3_park_m17_rotate_fly",
  "description": "ATLAS V3 tuned 50/65/50 foils (airframes/atlas_v3_v34_foils_50_65_50_tuned.json, the parameters on the board): parked nose-down at -17 deg (legs solved for -15.2; they settle ~1.8 deg under the weight), the nose fans M7-M9 rotate it up to the trim hover pitch at 3 deg/s, Stabilized lift-off to 2.5 m, 12 s hover, descent 0.4 m/s to 0.7 m, 0.15 m/s flare, cut, nose lowered back to -17 at 3 deg/s with a 4 s fade. For SITL or HITL (Fly live).",
  "max_time": 220,
  "params": {
    "COM_RC_IN_MODE": 3,
    "COM_DISARM_LAND": 3,
    "COM_DISARM_PRFLT": -1
  },
  "abort": {
    "max_tilt_deg": 100,
    "max_alt": 30,
    "crash_speed": 2.0
  },
  "attitude": {
    "park_pitch_deg": -15.2,
    "hover_pitch_deg": "trim",
    "hover_thrust": "trim"
  },
  "design": {
    "nose_lift": {
      "executor": "sim"
    }
  },
  "phases": [
    {
      "type": "wait_ready",
      "timeout": 45
    },
    {
      "type": "nose_lift",
      "name": "rotate_up",
      "motors": [
        6,
        7,
        8
      ],
      "rate_deg_s": 3,
      "timeout": 45,
      "timeout_s": 45
    },
    {
      "type": "stick",
      "name": "arm",
      "mode": "stabilized",
      "arm": true,
      "arm_tries": 25,
      "throttle": 0.0,
      "duration": 4
    },
    {
      "type": "stick",
      "name": "liftoff",
      "mode": "stabilized",
      "throttle": 0.5,
      "ramp_s": 3,
      "duration": 8,
      "alt_hold": {
        "target": 2.5
      }
    },
    {
      "type": "stick",
      "name": "hover",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 12,
      "alt_hold": {
        "target": 2.5
      }
    },
    {
      "type": "stick",
      "name": "descent",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 5.5,
      "alt_hold": {
        "target": 0.7,
        "rate": 0.4,
        "min": 0.2
      }
    },
    {
      "type": "stick",
      "name": "landing",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 30,
      "alt_hold": {
        "target": -0.5,
        "rate": 0.15,
        "min": 0.2
      },
      "until_ground": true,
      "settle": 0.3
    },
    {
      "type": "stick",
      "name": "cut",
      "mode": "stabilized",
      "throttle": 0.0,
      "ramp_s": 0.5,
      "duration": 1.5
    },
    {
      "type": "nose_lower",
      "name": "rotate_down",
      "motors": [
        6,
        7,
        8
      ],
      "target_pitch_deg": -15.2,
      "rate_deg_s": 3,
      "timeout": 60,
      "fade_s": 4,
      "px4_land": false
    },
    {
      "type": "wait",
      "duration": 2
    }
  ]
}