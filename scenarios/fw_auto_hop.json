{
  "max_time": 200,
  "design": {
    "nose_lift": {
      "executor": "firmware"
    }
  },
  "params": {
    "COM_RC_IN_MODE": 0,
    "RC_CHAN_CNT": 18,
    "RC_MAP_ROLL": 1,
    "RC_MAP_PITCH": 2,
    "RC_MAP_THROTTLE": 3,
    "RC_MAP_YAW": 4,
    "RC3_TRIM": 1000,
    "RC_MAP_KILL_SW": 9,
    "RC_KILLSWITCH_TH": 0.75,
    "COM_DISARM_LAND": -1,
    "COM_DISARM_PRFLT": -1,
    "NL_AUTO": 1,
    "NL_AUTO_WAIT": 3,
    "NL_AUTO_ALT": 1.5,
    "NL_AUTO_HOV": 30,
    "NL_AUTO_PILOT": 1400
  },
  "abort": {
    "max_tilt_deg": 100,
    "max_alt": 30,
    "crash_speed": 2.0
  },
  "name": "fw_auto_hop",
  "description": "NL_AUTO on the flight controller: SB on raises the nose and holds it; 3 s later the module flies the throttle itself: climb to 1.5 m (baro), hover 30 s, descend to touchdown, cut, lower the nose, disarm. The transmitter's throttle stays at zero throughout; only the kill switch (channel 9) is armed at the end as a guard. Needs the SITL build from scripts/build_nose_lift_firmware.sh and --px4-dir ~/PX4-nl.",
  "phases": [
    {
      "type": "rc",
      "name": "radio_on",
      "channels": {
        "7": 1500,
        "9": 1000
      },
      "throttle": 0.0,
      "duration": 2
    },
    {
      "type": "wait_ready",
      "timeout": 45
    },
    {
      "type": "rc",
      "name": "arm",
      "channels": {},
      "mode": "stabilized",
      "arm": true,
      "until": {
        "armed": true,
        "nl_state": "parked"
      },
      "timeout": 30
    },
    {
      "type": "rc",
      "name": "parked",
      "duration": 2
    },
    {
      "type": "rc",
      "name": "lift",
      "channels": {
        "7": 1000
      },
      "throttle": 0.0,
      "until": {
        "nl_state": "holding"
      },
      "timeout": 60
    },
    {
      "type": "rc",
      "name": "wait_takeoff",
      "throttle": 0.0,
      "until": {
        "nl_state": [
          "handover",
          "nosehold",
          "flying"
        ]
      },
      "timeout": 15
    },
    {
      "type": "rc",
      "name": "flight",
      "throttle": 0.0,
      "until": {
        "nl_state": "lowering"
      },
      "timeout": 90
    },
    {
      "type": "rc",
      "name": "lowered",
      "throttle": 0.0,
      "until": {
        "armed": false
      },
      "timeout": 40
    },
    {
      "type": "rc",
      "name": "guard_kill",
      "channels": {
        "9": 2000
      },
      "duration": 1
    }
  ]
}