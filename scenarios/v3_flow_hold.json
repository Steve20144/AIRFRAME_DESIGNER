{
  "name": "v3_flow_hold",
  "description": "ATLAS V3 indoor Position hold on optical flow + range only (GPS off; the flow sensor and EKF2 settings come from the task): parked and hovering at trim, lift off in Stabilized to 1.5 m, switch to Position hands-off for 20 s, a 3 s half forward stick push, release and hold 10 s, then land in Stabilized. Hover drift in 'pos_hold' is the placement metric.",
  "max_time": 200,
  "params": {
    "COM_RC_IN_MODE": 3,
    "COM_DISARM_LAND": 3,
    "COM_DISARM_PRFLT": -1,
    "MPC_XY_VEL_MAX": 2.0,
    "MPC_VEL_MANUAL": 2.0
  },
  "abort": {
    "max_tilt_deg": 100,
    "max_alt": 30,
    "crash_speed": 2.0
  },
  "phases": [
    {
      "type": "wait_ready",
      "timeout": 45
    },
    {
      "type": "stick",
      "name": "arm",
      "mode": "stabilized",
      "arm": true,
      "arm_tries": 25,
      "throttle": 0.0,
      "duration": 4
    },
    {
      "type": "stick",
      "name": "liftoff",
      "mode": "stabilized",
      "throttle": 0.5,
      "ramp_s": 3,
      "duration": 8,
      "alt_hold": {
        "target": 1.5
      }
    },
    {
      "type": "stick",
      "name": "settle",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 3,
      "alt_hold": {
        "target": 1.5
      }
    },
    {
      "type": "stick",
      "name": "pos_hold",
      "mode": "position",
      "throttle": 0.5,
      "duration": 20
    },
    {
      "type": "stick",
      "name": "push",
      "mode": "position",
      "throttle": 0.5,
      "duration": 3,
      "pitch": 0.5
    },
    {
      "type": "stick",
      "name": "stop_hold",
      "mode": "position",
      "throttle": 0.5,
      "duration": 10
    },
    {
      "type": "stick",
      "name": "landing",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 30,
      "alt_hold": {
        "target": -0.5,
        "rate": 0.4,
        "min": 0.2
      },
      "until_ground": true,
      "settle": 0.3
    },
    {
      "type": "stick",
      "name": "cut",
      "mode": "stabilized",
      "throttle": 0.0,
      "ramp_s": 0.5,
      "duration": 1.5
    },
    {
      "type": "nose_lower",
      "motors": [
        8,
        9
      ],
      "rate_deg_s": 3,
      "timeout": 60,
      "fade_s": 4,
      "px4_land": false
    },
    {
      "type": "wait",
      "duration": 2
    }
  ],
  "attitude": {
    "park_pitch_deg": "hover",
    "hover_pitch_deg": "trim",
    "hover_thrust": "trim"
  }
}