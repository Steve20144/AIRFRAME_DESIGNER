{
  "name": "fw_nose_lift_takeoff_indoor",
  "description": "fw_nose_lift_takeoff as flown indoors: height from the barometer only (EKF2_HGT_REF 0) and no GPS (EKF2_GPS_CTRL 0), so an accelerometer bias from fan vibration drifts PX4's height estimate the way it did on the bench (brain/lessons/fan-vibration-drifts-ekf-height.md). Without GPS PX4's arming summary never lists a position mode, so the first phase waits 20 s for the estimator instead of wait_ready; the arm phase reports it if PX4 refuses Stabilized. Needs --px4-dir ~/PX4-nl.",
  "max_time": 150,
  "design": {
    "nose_lift": {
      "executor": "firmware"
    }
  },
  "params": {
    "COM_RC_IN_MODE": 0,
    "RC_CHAN_CNT": 18,
    "RC_MAP_ROLL": 1,
    "RC_MAP_PITCH": 2,
    "RC_MAP_THROTTLE": 3,
    "RC_MAP_YAW": 4,
    "RC3_TRIM": 1000,
    "RC_MAP_KILL_SW": 9,
    "RC_KILLSWITCH_TH": 0.75,
    "COM_DISARM_LAND": 3,
    "EKF2_HGT_REF": 0,
    "EKF2_GPS_CTRL": 0
  },
  "abort": {
    "max_tilt_deg": 100,
    "max_alt": 30,
    "crash_speed": 2.0
  },
  "phases": [
    {
      "type": "wait",
      "name": "wait_ready",
      "duration": 20.0
    },
    {
      "type": "rc",
      "name": "arm",
      "channels": {
        "7": 1500,
        "9": 1000
      },
      "mode": "stabilized",
      "arm": true,
      "until": {
        "armed": true,
        "nl_state": "parked"
      },
      "timeout": 30
    },
    {
      "type": "rc",
      "name": "parked",
      "duration": 2
    },
    {
      "type": "rc",
      "name": "lift",
      "channels": {
        "7": 1000
      },
      "until": {
        "nl_state": "holding"
      },
      "timeout": 40
    },
    {
      "type": "rc",
      "name": "hold",
      "duration": 3
    },
    {
      "type": "rc",
      "name": "liftoff",
      "throttle": 0.5,
      "throttle_from": 0.0,
      "ramp_s": 3,
      "alt_hold": {
        "target": 2.5
      },
      "until": {
        "nl_state": "flying"
      },
      "timeout": 20
    },
    {
      "type": "rc",
      "name": "climb",
      "throttle": 0.5,
      "alt_hold": {
        "target": 2.5
      },
      "duration": 6
    },
    {
      "type": "rc",
      "name": "hover",
      "throttle": 0.5,
      "alt_hold": {
        "target": 2.5
      },
      "duration": 10
    },
    {
      "type": "rc",
      "name": "descend",
      "throttle": 0.5,
      "alt_hold": {
        "target": -0.5,
        "rate": 0.4,
        "min": 0.2
      },
      "duration": 12
    },
    {
      "type": "rc",
      "name": "cut",
      "throttle": 0.0,
      "ramp_s": 0.5,
      "until": {
        "armed": false
      },
      "timeout": 40
    }
  ]
}
