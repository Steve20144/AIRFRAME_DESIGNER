{
  "name": "2026-10-05_atlas_v1_m001_hover",
  "description": "ATLAS v1 full scale, first mass placement (airframes/atlas_v1_m001.json, 46.0 kg of clicked parts, nine DS-215 class fans at the fan mass points, wing jets 75 deg, tail fans vertical): parked on its wing tips and tail skid at the hover trim pitch (about 10 deg nose-up), arm in Stabilized, lift off to 2.5 m, 60 s hands-off hover, gentle landing. No nose lift, no H-FLOW, MC_AIRMODE 0.",
  "max_time": 200,
  "params": {
    "COM_RC_IN_MODE": 3,
    "COM_DISARM_LAND": 3,
    "COM_DISARM_PRFLT": -1,
    "MC_AIRMODE": 0
  },
  "abort": {
    "max_tilt_deg": 100,
    "max_alt": 30,
    "crash_speed": 2.0
  },
  "attitude": {
    "hover_pitch_deg": "trim",
    "park_pitch_deg": "hover",
    "hover_thrust": "trim"
  },
  "design": {
    "nose_lift": {
      "enabled": false
    },
    "flow_sensor": {
      "enabled": false
    }
  },
  "phases": [
    {
      "type": "wait_ready",
      "timeout": 45
    },
    {
      "type": "stick",
      "name": "arm",
      "mode": "stabilized",
      "arm": true,
      "arm_tries": 25,
      "throttle": 0.0,
      "until": {
        "armed": true
      },
      "timeout": 40
    },
    {
      "type": "stick",
      "name": "liftoff",
      "mode": "stabilized",
      "throttle": 0.5,
      "ramp_s": 3,
      "duration": 8,
      "alt_hold": {
        "target": 2.5
      }
    },
    {
      "type": "stick",
      "name": "hover",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 60,
      "alt_hold": {
        "target": 2.5
      }
    },
    {
      "type": "stick",
      "name": "descent",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 5.5,
      "alt_hold": {
        "target": 0.7,
        "rate": 0.4,
        "min": 0.2
      }
    },
    {
      "type": "stick",
      "name": "landing",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 30,
      "alt_hold": {
        "target": -0.5,
        "rate": 0.15,
        "min": 0.2
      },
      "until_ground": true,
      "settle": 0.3
    },
    {
      "type": "stick",
      "name": "cut",
      "mode": "stabilized",
      "throttle": 0.0,
      "ramp_s": 0.5,
      "duration": 1.5
    }
  ]
