{
  "name": "fw_nose_lift_balance12",
  "description": "Balance at 12 deg on the two nose fans as the aircraft flies it today (board firmware without the hold fix: the lift never reports Holding and keeps regulating toward NL_TGT until NL_TOUT, here 60 s): SB on for 30 s, then SB off, 12 s of lowering, kill switch. The nose must never pass 14 deg. Park 5 deg (the aircraft, 23 Sep). Needs --px4-dir ~/PX4-nl.",
  "max_time": 150,
  "attitude": {
    "park_pitch_deg": 5.0,
    "hover_pitch_deg": 24
  },
  "design": {
    "nose_lift": {
      "executor": "firmware",
      "target_pitch_deg": 12.0,
      "timeout_s": 60,
      "hold_timeout_s": 90
    }
  },
  "params": {
    "COM_RC_IN_MODE": 0,
    "RC_CHAN_CNT": 18,
    "RC_MAP_ROLL": 1,
    "RC_MAP_PITCH": 2,
    "RC_MAP_THROTTLE": 3,
    "RC_MAP_YAW": 4,
    "RC3_TRIM": 1000,
    "RC_MAP_KILL_SW": 9,
    "RC_KILLSWITCH_TH": 0.75,
    "COM_DISARM_LAND": 3
  },
  "abort": {
    "max_tilt_deg": 60,
    "max_alt": 2,
    "crash_speed": 2.0
  },
  "phases": [
    {
      "type": "wait_ready",
      "timeout": 45
    },
    {
      "type": "rc",
      "name": "arm",
      "channels": {
        "7": 1500,
        "9": 1000
      },
      "mode": "stabilized",
      "arm": true,
      "until": {
        "armed": true,
        "nl_state": "parked"
      },
      "timeout": 30
    },
    {
      "type": "rc",
      "name": "parked",
      "duration": 2
    },
    {
      "type": "rc",
      "name": "raise",
      "channels": {
        "7": 1000
      },
      "throttle": 0.0,
      "duration": 30
    },
    {
      "type": "rc",
      "name": "switch_off",
      "channels": {
        "7": 1500
      },
      "until": {
        "nl_state": "lowering"
      },
      "timeout": 1
    },
    {
      "type": "rc",
      "name": "lowered",
      "duration": 12
    },
    {
      "type": "rc",
      "name": "kill",
      "channels": {
        "9": 2000
      },
      "until": {
        "armed": false
      },
      "timeout": 10
    }
  ]
}
