{
  "name": "2026-09-30_2136_v3_foils_out50_mid65_in50deg_park-16_rotate_poshold_hflow",
  "description": "ATLAS V3, foils 50 / 65 / 50 deg, tuned gains, parked at -16 deg; H-FLOW as built (frame-fixed, tilted 20.4 deg, right below the Pixhawk) with GPS off. Nose fans rotate it up to the hover pitch, arm in Stabilized and climb the moment PX4 is armed, lift off to 1.5 m, settle 3 s, then 60 s hands-off in Position mode holding on flow and range only, then the gentle landing and the nose back down to -16. MC_AIRMODE 0. For SITL or HITL (Fly live); in HITL the board also needs NL_EN 0 and COM_RC_IN_MODE 1 (sim-driven nose lift, app sticks only).",
  "max_time": 260,
  "params": {
    "COM_RC_IN_MODE": 3,
    "COM_DISARM_LAND": 3,
    "COM_DISARM_PRFLT": -1,
    "MC_AIRMODE": 0
  },
  "abort": {
    "max_tilt_deg": 100,
    "max_alt": 30,
    "crash_speed": 2.0
  },
  "attitude": {
    "park_pitch_deg": -14.15,
    "hover_pitch_deg": "trim",
    "hover_thrust": "trim"
  },
  "design": {
    "nose_lift": {
      "executor": "sim"
    },
    "flow_sensor": {
      "enabled": true
    }
  },
  "phases": [
    {
      "type": "wait_ready",
      "timeout": 45
    },
    {
      "type": "nose_lift",
      "name": "rotate_up",
      "motors": [
        6,
        7,
        8
      ],
      "rate_deg_s": 3,
      "timeout": 45,
      "timeout_s": 45
    },
    {
      "type": "stick",
      "name": "arm",
      "mode": "stabilized",
      "arm": true,
      "arm_tries": 25,
      "throttle": 0.0,
      "until": {
        "armed": true
      },
      "timeout": 40
    },
    {
      "type": "stick",
      "name": "liftoff",
      "mode": "stabilized",
      "throttle": 0.5,
      "ramp_s": 3,
      "duration": 8,
      "alt_hold": {
        "target": 1.5
      }
    },
    {
      "type": "stick",
      "name": "settle",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 3,
      "alt_hold": {
        "target": 1.5
      }
    },
    {
      "type": "stick",
      "name": "hover",
      "mode": "position",
      "throttle": 0.5,
      "duration": 60
    },
    {
      "type": "stick",
      "name": "descent",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 3,
      "alt_hold": {
        "target": 0.7,
        "rate": 0.4,
        "min": 0.2
      }
    },
    {
      "type": "stick",
      "name": "landing",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 30,
      "alt_hold": {
        "target": -0.5,
        "rate": 0.15,
        "min": 0.2
