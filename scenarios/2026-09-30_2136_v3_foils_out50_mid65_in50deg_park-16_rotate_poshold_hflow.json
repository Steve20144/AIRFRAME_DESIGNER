    {
      "type": "stick",
      "name": "cut",
      "mode": "stabilized",
      "throttle": 0.0,
      "ramp_s": 0.5,
      "duration": 1.5
    },
    {
      "type": "nose_lower",
      "name": "rotate_down",
      "motors": [
        6,
        7,
        8
      ],
      "target_pitch_deg": -14.15,
      "rate_deg_s": 3,
      "timeout": 60,
      "fade_s": 4,
      "px4_land": false
