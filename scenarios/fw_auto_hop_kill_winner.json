{
  "max_time": 200,
  "design": {
    "nose_lift": {
      "executor": "firmware"
    }
  },
  "params": {
    "COM_RC_IN_MODE": 0,
    "RC_CHAN_CNT": 18,
    "RC_MAP_ROLL": 1,
    "RC_MAP_PITCH": 2,
    "RC_MAP_THROTTLE": 3,
    "RC_MAP_YAW": 4,
    "RC3_MIN": 1000,
    "RC3_TRIM": 1000,
    "RC_MAP_KILL_SW": 9,
    "RC_KILLSWITCH_TH": 0.75,
    "COM_DISARM_LAND": -1,
    "COM_DISARM_PRFLT": -1,
    "NL_AUTO": 1,
    "NL_AUTO_WAIT": 3,
    "NL_AUTO_ALT": 1.0,
    "NL_AUTO_HOV": 15.0,
    "NL_AUTO_PILOT": 1400
  },
  "abort": {
    "max_tilt_deg": 100,
    "max_alt": 30,
    "crash_speed": 10.0
  },
  "name": "fw_auto_hop_kill_winner",
  "description": "Automatic flight to 1.0 m; 8 s after the takeoff the kill switch goes on: every motor must stop at once and the module must latch aborted. The aircraft falls from the hover, that is what a kill does.",
  "phases": [
    {
      "type": "rc",
      "name": "radio_on",
      "channels": {
        "7": 1500,
        "9": 1000
      },
      "throttle": 0.0,
      "duration": 2
    },
    {
      "type": "wait_ready",
      "timeout": 45
    },
    {
      "type": "rc",
      "name": "arm",
      "channels": {},
      "mode": "stabilized",
      "arm": true,
      "until": {
        "armed": true,
        "nl_state": "parked"
      },
      "timeout": 30
    },
    {
      "type": "rc",
      "name": "parked",
      "duration": 2
    },
    {
      "type": "rc",
      "name": "lift",
      "channels": {
        "7": 1000
      },
      "throttle": 0.0,
      "until": {
        "nl_state": "holding"
      },
      "timeout": 60
    },
    {
      "type": "rc",
      "name": "wait_takeoff",
      "throttle": 0.0,
      "until": {
        "nl_state": [
          "handover",
          "nosehold",
          "flying"
        ]
      },
      "timeout": 15
    },
    {
      "type": "rc",
      "name": "climb_and_hover",
      "throttle": 0.0,
      "duration": 8
    },
    {
      "type": "rc",
      "name": "kill",
      "channels": {
        "9": 2000
      },
      "until": {
        "motors_off": true
      },
      "timeout": 2
    },
    {
      "type": "rc",
      "name": "after",
      "until": {
        "armed": false
      },
      "timeout": 8,
      "expect": {
        "nl_abort": "kill switch"
      }
    }
  ]
}
