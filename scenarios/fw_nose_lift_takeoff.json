{
  "name": "fw_nose_lift_takeoff",
  "description": "The nose lift on the flight controller (nose_lift PX4 module, needs the SITL build from scripts/build_nose_lift_firmware.sh and --px4-dir ~/PX4-nl): arm in Stabilized with a scripted transmitter, every motor stays stopped; SB (channel 7, active low) raises the nose on motors 9 and 10 at 3 deg/s and holds it; the throttle hands over to PX4, which lifts off and hovers about 2.5 m, then descends and lands. Channel 9 is the kill switch here (the real button's channel is still to be found).",
  "max_time": 150,
  "design": {
    "nose_lift": {
      "executor": "firmware"
    }
  },
  "params": {
    "COM_RC_IN_MODE": 0,
    "RC_CHAN_CNT": 18,
    "RC_MAP_ROLL": 1,
    "RC_MAP_PITCH": 2,
    "RC_MAP_THROTTLE": 3,
    "RC_MAP_YAW": 4,
    "RC3_TRIM": 1000,
    "RC_MAP_KILL_SW": 9,
    "RC_KILLSWITCH_TH": 0.75,
    "COM_DISARM_LAND": 3
  },
  "abort": {
    "max_tilt_deg": 100,
    "max_alt": 30,
    "crash_speed": 2.0
  },
  "phases": [
    {"type": "wait_ready", "timeout": 45},
    {"type": "rc", "name": "arm", "channels": {"7": 1500, "9": 1000}, "mode": "stabilized", "arm": true,
     "until": {"armed": true, "nl_state": "parked"}, "timeout": 30},
    {"type": "rc", "name": "parked", "duration": 2},
    {"type": "rc", "name": "lift", "channels": {"7": 1000}, "until": {"nl_state": "holding"}, "timeout": 40},
    {"type": "rc", "name": "hold", "duration": 3},
    {"type": "rc", "name": "liftoff", "throttle": 0.5, "throttle_from": 0.0, "ramp_s": 3,
     "alt_hold": {"target": 2.5}, "until": {"nl_state": "flying"}, "timeout": 20},
    {"type": "rc", "name": "climb", "throttle": 0.5, "alt_hold": {"target": 2.5}, "duration": 6},
    {"type": "rc", "name": "hover", "throttle": 0.5, "alt_hold": {"target": 2.5}, "duration": 10},
    {"type": "rc", "name": "descend", "throttle": 0.5, "alt_hold": {"target": -0.5, "rate": 0.4, "min": 0.2}, "duration": 12},
    {"type": "rc", "name": "cut", "throttle": 0.0, "ramp_s": 0.5, "until": {"armed": false}, "timeout": 40}
  ]
}
