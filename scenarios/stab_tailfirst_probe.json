{
  "name": "stab_tailfirst_probe",
  "description": "Diagnostic: after liftoff, 3 s of nose-up stick (tail-first acceleration) at 4 m, then sticks centred 8 s; measures whether a pitch error persists while moving tail-first.",
  "max_time": 200,
  "params": {
    "COM_RC_IN_MODE": 3,
    "COM_DISARM_LAND": 3,
    "COM_DISARM_PRFLT": -1
  },
  "abort": {
    "max_tilt_deg": 100,
    "max_alt": 30,
    "crash_speed": 2.0
  },
  "phases": [
    {
      "type": "wait_ready",
      "timeout": 45
    },
    {
      "type": "nose_lift",
      "motors": [
        8,
        9
      ],
      "rate_deg_s": 3,
      "timeout": 60,
      "timeout_s": 60
    },
    {
      "type": "stick",
      "name": "arm",
      "mode": "stabilized",
      "arm": true,
      "arm_tries": 25,
      "throttle": 0.0,
      "duration": 4
    },
    {
      "type": "stick",
      "name": "liftoff",
      "mode": "stabilized",
      "throttle": 0.5,
      "ramp_s": 1.0,
      "duration": 8,
      "alt_hold": {
        "target": 2.5,
        "max_corr": 0.25
      }
    },
    {
      "type": "stick",
      "name": "nose_up_stick",
      "mode": "stabilized",
      "throttle": 0.5,
      "pitch": -0.6,
      "duration": 3,
      "alt_hold": {
        "target": 4.0
      }
    },
    {
      "type": "stick",
      "name": "coast",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 8,
      "alt_hold": {
        "target": 4.0
      }
    },
    {
      "type": "stick",
      "name": "landing",
      "mode": "stabilized",
      "throttle": 0.5,
      "duration": 30,
      "alt_hold": {
        "target": -0.5,
        "rate": 0.4,
        "min": 0.2
      },
      "until_ground": true,
      "settle": 0.3
    },
    {
      "type": "stick",
      "name": "cut",
      "mode": "stabilized",
      "throttle": 0.0,
      "ramp_s": 0.5,
      "duration": 1.5
    },
    {
      "type": "nose_lower",
      "motors": [
        8,
        9
      ],
      "rate_deg_s": 3,
      "timeout": 60,
      "fade_s": 4,
      "px4_land": false
    },
    {
      "type": "wait",
      "duration": 2
    }
  ]
}